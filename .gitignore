# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.venv/
venv/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Local configuration and secrets.
#
# These must never be committed: a real config.toml can name a browser to read
# cookies from, and a local override may embed machine-specific paths.
config.local.toml
.env
*.local.toml
cookies.txt

# Anything that looks like a credential, as a second line of defence behind the
# privacy audit. See docs/security.md.
secrets.*
*.pem
*.key
*.p12
*.keystore

# The Android client lives in its own repository.
#
# It is a separate application with its own build system, its own release
# cycle and its own dependency set, and keeping a second Gradle project in
# this tree would make the first clone of a Python tool 175 MB. The build
# script and docs/android.md stay here and check the client out where they
# need it.
# See docs/android.md.
/android/
