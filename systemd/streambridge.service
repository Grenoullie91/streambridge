[Unit]
Description=StreamBridge local streaming bridge (search -> MPD)
Documentation=man:streambridge-server(1)
# Network access is needed to resolve sources, so start after it is up.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Adjust if you installed somewhere other than ~/.local/bin, or if you run
# from a checkout: ExecStart=/path/to/checkout/.venv/bin/streambridge-server
ExecStart=%h/.local/bin/streambridge-server
Restart=on-failure
RestartSec=5

# Loopback only. This is a safety net; the server itself refuses any
# non-loopback bind address.
Environment=STREAMBRIDGE_HOST=127.0.0.1
Environment=STREAMBRIDGE_PORT=8787
Environment=STREAMBRIDGE_LOG_LEVEL=INFO

# To reach the server from a phone, all three of these have to change together.
# The server refuses to start on a network address without a token, so this
# cannot be switched on by accident.
#
# Set host to a specific LAN address rather than 0.0.0.0: binding every
# interface also binds the VPN, the container bridges and anything else the
# machine has, and none of those need the player.
#
# The token is a shared secret, so keep it out of this file if the unit is
# ever read by something you do not control. Write it to
# ~/.config/streambridge/secrets.env with mode 600 and uncomment the
# EnvironmentFile line instead:
#
#   Environment=STREAMBRIDGE_HOST=192.0.2.20
#   Environment=STREAMBRIDGE_ALLOW_LAN=true
#   Environment=STREAMBRIDGE_ACCESS_TOKEN=…
#   #EnvironmentFile=%h/.config/streambridge/secrets.env

# Optional: uncomment if searches start failing with a bot check.
# Environment=STREAMBRIDGE_COOKIES_FROM_BROWSER=firefox

# A user unit already runs as the invoking user. Setting User= here is
# rejected by systemd (216/GROUP), so it is deliberately absent.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# Writable paths. The cache is throw-away by design; the state directory holds
# favourites and history.
#
# Both must already exist. A ReadWritePaths entry for a missing directory
# makes the unit fail to start with 226/NAMESPACE before a single line of
# Python runs, and scripts/install.sh creates them for that reason.
#
# StateDirectory=/CacheDirectory= are deliberately NOT used: on this systemd
# they make a user unit symlink ~/.local/state/<name> at ~/.config/<name>,
# which quietly moves a user's listening history into their configuration
# directory. The XDG separation is worth more than the automatic creation.
ReadWritePaths=%h/.cache/streambridge %h/.local/state/streambridge

# MPD's playlist_directory must be writable too: MPD refuses a playlist load
# from anywhere else, and that load is how a queued track keeps its title in
# ncmpcpp instead of showing a bare URL. It lives in a machine-specific place,
# so it cannot be listed here. scripts/install.sh detects it and writes
# ~/.config/systemd/user/streambridge.service.d/playlist-dir.conf. If queuing
# fails with "Access denied" and that file is missing, add it yourself:
#
#   [Service]
#   ReadWritePaths=/path/from/your/mpd.conf/playlists

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute must stay false: the extractor binary needs to be
# executable, and some Python extension modules map memory as executable.
MemoryDenyWriteExecute=false

# Only what a local helper needs: no outbound access except TCP, no privileges.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Bound resource usage. TasksMax leaves room for the thread that serves each
# audio stream to MPD, plus the extractor's child processes.
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=default.target
